# Função para remover todos containers e volumes Docker
dockerkill() {
  read "CONFIRM?⚠️ Tem certeza que quer remover TODOS os containers e volumes Docker? (y/n) "
  if [[ "$CONFIRM" != "y" && "$CONFIRM" != "Y" ]]; then
    echo "Operação cancelada."
    return 1
  fi

  echo "Removendo todos os containers..."
  docker rm -f $(docker ps -aq)

  echo "Removendo volumes associados..."
  docker volume prune -f

  echo "Todos containers e volumes removidos."
}


# Função para matar processo por porta
killp() {
  if [[ -z "$1" ]]; then
    echo "Uso: killp <porta>"
    return 1
  fi

  PORT=$1
  PIDS=$(lsof -ti :$PORT)

  if [[ -z "$PIDS" ]]; then
    echo "Nenhum processo encontrado na porta $PORT"
  else
    echo "Matando processos na porta $PORT..."
    # Usa xargs para passar cada PID corretamente para kill
    echo "$PIDS" | xargs -r kill -9
    echo "Processos finalizados."
  fi
}

