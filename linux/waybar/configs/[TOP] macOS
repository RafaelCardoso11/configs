// macOS-style menu bar: thin, full width, translucent
{
"layer": "top",
"output": "DP-3",
"exclusive": true,
"passthrough": false,
"position": "top",
"height": 34,
"spacing": 0,
"fixed-center": true,
"ipc": true,

"modules-left": [
	"custom/apple",
	"custom/window",
	"hyprland/workspaces#mac",
	"custom/scratch",
	"group/stats",
	"network#ip",
	],

"modules-center": [],

"modules-right": [
	"mpris#mac",
	"tray",
	"custom/thememode",
	"custom/presentation",
	"bluetooth#mac",
	"pulseaudio#mac",
	"network#mac",
	"custom/spotlight",
	"clock#mac",
	"custom/swaync",
	],

"custom/apple": {
	"exec": "$HOME/.config/hypr/scripts/ArchInfo.sh",
	"return-type": "json",
	"interval": 60,
	"format": "{}",
	"on-click": "vicinae vicinae://launch/scripts",
	"on-click-right": "vicinae toggle",
	},

"custom/scratch": {
	"exec": "$HOME/.config/hypr/scripts/ScratchStatus.sh",
	"return-type": "json",
	"format": "{}",
	"restart-interval": 2,
	"on-click": "$HOME/.config/hypr/scripts/ToggleScratch.sh",
	},

"custom/window": {
	"exec": "$HOME/.config/hypr/scripts/ActiveWindow.sh",
	"format": "{}",
	"tooltip": false,
	"restart-interval": 2,
	},

"hyprland/workspaces#mac": {
	"active-only": false,
	"all-outputs": true,
	"ignore-workspaces": ["scratch"],
	"format": "{icon}",
	"format-icons": {
		"1": "󰲠",
		"2": "󰲢",
		"3": "󰲤",
		"default": "○",
		},
	"on-click": "activate",
	},

"custom/thememode": {
	"align": 0.5,
	"exec": "$HOME/.config/hypr/scripts/ThemeModeStatus.sh",
	"return-type": "json",
	"interval": "once",
	"signal": 9,
	"on-click": "$HOME/.config/hypr/scripts/DarkLight.sh",
	},

"custom/presentation": {
	"align": 0.5,
	"exec": "$HOME/.config/hypr/scripts/PresentationStatus.sh",
	"return-type": "json",
	"interval": "once",
	"signal": 8,
	"on-click": "$HOME/.config/hypr/scripts/PresentationMode.sh",
	},

"bluetooth#mac": {
	"align": 0.5,
	"format": "󰂯",
	"format-off": "󰂲",
	"format-disabled": "󰂲",
	"format-connected": "󰂱",
	"tooltip-format": "{controller_alias}: {status}",
	"tooltip-format-connected": "{device_enumerate}",
	"tooltip-format-enumerate-connected": "{device_alias}",
	"on-click": "blueman-manager",
	},

"pulseaudio#mac": {
	"align": 0.5,
	"format": "{icon}",
	"format-muted": "󰝟",
	"format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
	"tooltip-format": "{desc} — {volume}%",
	"on-click": "pavucontrol",
	"on-scroll-up": "$HOME/.config/hypr/scripts/Volume.sh --inc",
	"on-scroll-down": "$HOME/.config/hypr/scripts/Volume.sh --dec",
	},

"network#mac": {
	"align": 0.5,
	"format-ethernet": "󰈀",
	"format-wifi": "{icon}",
	"format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
	"format-disconnected": "󰤮",
	"tooltip-format": "{ifname}: {ipaddr}",
	"tooltip-format-wifi": "{essid} ({signalStrength}%)",
	"on-click": "vicinae 'vicinae://launch/@dagimg-dot/store.vicinae.wifi-commander/scan-wifi'",
	},

"group/stats": {
	"orientation": "horizontal",
	"modules": ["cpu#mac", "memory#mac"],
	},

"cpu#mac": {
	"format": "󰻠 {usage}%",
	"interval": 3,
	"tooltip-format": "CPU {usage}% — load {load}",
	"on-click": "kitty --title btop -e btop",
	},

"memory#mac": {
	"format": "󰍛 {used:0.1f}G",
	"interval": 5,
	"tooltip-format": "RAM {used:0.1f} / {total:0.1f} GiB ({percentage}%)\nSwap {swapUsed:0.1f} / {swapTotal:0.1f} GiB",
	"on-click": "kitty --title btop -e btop",
	},

"network#ip": {
	"format": "{ipaddr}",
	"format-disconnected": "",
	"tooltip-format": "{ifname}: {ipaddr}/{cidr} via {gwaddr}\nClick to copy",
	"on-click": "ip -4 -o route get 1 | grep -oP 'src \\K\\S+' | wl-copy -n && notify-send -a Network 'IP copied'",
	},

"mpris#mac": {
	"format": "{status_icon}  {title}",
	"format-paused": "{status_icon}  <span alpha='60%'>{title}</span>",
	"format-stopped": "",
	"status-icons": { "playing": "󰏤", "paused": "󰐊", "stopped": "󰓛" },
	"title-len": 40,
	"tooltip-format": "{player}: {title} — {artist}",
	"on-click": "playerctl play-pause",
	"on-click-right": "playerctl next",
	"on-scroll-up": "playerctl position 5+",
	"on-scroll-down": "playerctl position 5-",
	},

"custom/spotlight": {
	"align": 0.5,
	"format": "󰍉",
	"tooltip": true,
	"tooltip-format": "Search (SUPER+D)",
	"on-click": "vicinae toggle",
	},

"clock#mac": {
	"format": "{:%a %b %d  %H:%M}",
	"tooltip-format": "<tt>{calendar}</tt>",
	"calendar": { "mode": "month", "format": { "today": "<b><u>{}</u></b>" } },
	},

"tray": {
	"icon-size": 16,
	"spacing": 0,
},

"custom/swaync": {
	"tooltip": true,
	"tooltip-format": "Left Click: Launch Notification Center\nRight Click: Do not Disturb",
	"format": "{} {icon} ",
	"format-icons": {
		"notification": "<span foreground='red'><sup></sup></span>",
		"none": "",
		"dnd-notification": "<span foreground='red'><sup></sup></span>",
		"dnd-none": "",
		"inhibited-notification": "<span foreground='red'><sup></sup></span>",
		"inhibited-none": "",
		"dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
		"dnd-inhibited-none": ""
	},
	"return-type": "json",
	"exec-if": "which swaync-client",
	"exec": "swaync-client -swb",
	"on-click": "sleep 0.1 && swaync-client -t -sw",
	"on-click-right": "swaync-client -d -sw",
	"escape": true,
},
}
